{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Edit", "Write", "MultiEdit"],
    "ask": [],
    "additionalDirectories": [".claude/wip", "../.claude", "../docs"]
  },
  "hooks": {
    "UserPromptSubmit": [{"matcher":"","hooks":[{"type":"command","command":"bash \"$CLAUDE_PROJECT_DIR/../.claude/hooks/cmdhist.sh\" pre"}]}],
    "Stop": [{"matcher":"","hooks":[{"type":"command","command":"bash \"$CLAUDE_PROJECT_DIR/../.claude/hooks/cmdhist.sh\" post"}]}],
    "PostToolUse": [{"matcher":"Edit|Write|MultiEdit","hooks":[{"type":"command","command":"bash \"$CLAUDE_PROJECT_DIR/../.claude/hooks/review-reminder.sh\" 2>/dev/null || true"}]}]
  }
}
